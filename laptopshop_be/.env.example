# Mẫu cấu hình biến môi trường kết nối SQL Server cho LaptopShop Backend
# Sao chép file này thành .env (không commit .env lên Git) và điền thông tin máy bạn:

DB_URL=jdbc:sqlserver://localhost:1433;databaseName=LaptopShopDB;encrypt=true;trustServerCertificate=true
DB_USERNAME=your_sql_username
DB_PASSWORD=your_sql_password
JPA_DDL_AUTO=validate
SERVER_PORT=8080
