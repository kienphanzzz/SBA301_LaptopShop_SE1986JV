# Mau cau hinh bien moi truong cho LaptopShop Backend
# Sao chep file nay thanh .env (khong commit .env len Git) va dien thong tin:

# ============================
# DATABASE (SQL Server)
# ============================
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=LaptopShopDB;encrypt=true;trustServerCertificate=true
DB_USERNAME=your_sql_username
DB_PASSWORD=your_sql_password
JPA_DDL_AUTO=validate

# ============================
# SERVER
# ============================
SERVER_PORT=8080

# ============================
# JWT & SECURITY
# ============================
# Tao bang lenh: openssl rand -hex 32
JWT_SECRET=your-super-secret-key-at-least-32-characters-long
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# LOCAL DEV: false | PRODUCTION (HTTPS): true
COOKIE_SECURE=false

# ============================
# CORS (Danh sach Frontend origins duoc phep)
# LOCAL: http://localhost:5173
# PRODUCTION: https://your-app.vercel.app
# Nhieu origins cach nhau dau phay:
# ALLOWED_ORIGINS=https://app.vercel.app,https://www.yourdomain.com
# ============================
ALLOWED_ORIGINS=http://localhost:5173
